# EWB Vault Protocol — Environment Configuration
# Copy to .env and fill in values
# NEVER commit .env to git

# Network RPC endpoints
RPC_URL_SEPOLIA=https://rpc.sepolia.org
RPC_URL=https://eth.llamarpc.com

# Deploy wallet — THROWAWAY WALLET ONLY
# NEVER use Ballet wallet (0xc82A59594560A3010F336ebe2e9CC4794DCD46cf)
PRIVATE_KEY=

# Etherscan verification
ETHERSCAN_API_KEY=

# Vite frontend (mainnet dashboard)
VITE_ALCHEMY_MAINNET_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
VITE_BALLET_WALLET=0xc82A59594560A3010F336ebe2e9CC4794DCD46cf

# Sepolia constructor addresses (fill before deploy)
SEPOLIA_SAFE_MULTISIG=
SEPOLIA_COLD_WALLET=
SEPOLIA_EWB_POOL=0x0000000000000000000000000000000000000000
